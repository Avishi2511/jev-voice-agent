APP_ENV=dev                 # dev | staging | prod
JEV_MODEL=jev-1.14.0        # pinned; jev-latest rejected outside dev
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_S=2.0
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
PUBLIC_URL=                 # https URL Vobiz can reach (ngrok etc.)
SCRIPT_PATH=scripts/emi_reminder_en.yaml
BASELINE_MODE=false         # true = plain LLM agent (Stage 2)
SHADOW_MODE=false           # true = Phase A silently beside the baseline (needs BASELINE_MODE=true)
# AB_HYBRID_PERCENT=10      # 0-100 routes that share of calls to hybrid; leave unset for no routing
KILL_SWITCH_PATH=KILL_HYBRID
SAVE_TRANSCRIPTS=false      # contains PII; see docs/compliance.md
